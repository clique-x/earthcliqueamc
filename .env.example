# Copy to .env and fill in. Never commit .env.
NODE_ENV=development

# Matches docker-compose.yml (Postgres+PostGIS on 5433, Redis on 6380)
DATABASE_URL=postgres://amc:amc@localhost:5433/amc
REDIS_URL=redis://localhost:6380

API_PORT=4000
WEB_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# At least 32 characters: openssl rand -hex 32
JWT_SECRET=

SMS_PROVIDER=console
STORAGE_DRIVER=local

# Optional: Firebase service account JSON for background rings
FIREBASE_SERVICE_ACCOUNT=

# Dev seed (pnpm db:seed). Default location is Ahmedabad.
SEED_LAT=23.0225
SEED_LNG=72.5714
SEED_ADMIN_EMAIL=admin@earthclique.test
SEED_ADMIN_PASSWORD=admin12345
SEED_COMPANY_EMAIL=demo@acme.test
SEED_COMPANY_PASSWORD=demo12345
SEED_VENDOR_EMAIL=vendor@netsecure.test
SEED_VENDOR_PASSWORD=vendor12345
